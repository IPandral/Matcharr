MATCHARR_IMAGE=ghcr.io/ipandral/matcharr:latest
MATCHARR_PORT=5000
MATCHARR_BIND_ADDRESS=127.0.0.1
MATCHARR_PUBLIC_URL=
SECRET_KEY=
MATCHARR_SECURE_COOKIES=true

RUSTYDB_HOST=rustydb
RUSTYDB_WIRE_PORT=3307
RUSTYDB_USERNAME=matcharr
RUSTYDB_PASSWORD=

MEDIA_SERVER_TYPE=plex

PLEX_URL=http://192.168.1.100:32400
PLEX_TOKEN=
PLEX_LIBRARY_ID=1
PLEX_LIBRARY_NAME=Movies
PLEX_TIMEOUT=10

JELLYFIN_URL=http://192.168.1.100:8096
JELLYFIN_API_KEY=
JELLYFIN_USER_ID=
JELLYFIN_LIBRARY_ID=
JELLYFIN_LIBRARY_NAME=Movies
JELLYFIN_TIMEOUT=10
MATCHARR_AUTO_SYNC=true

MATCHARR_INVITE_CODE_LENGTH=8
MATCHARR_SWIPE_DISTANCE_THRESHOLD=100
MATCHARR_SWIPE_VELOCITY_THRESHOLD=0.5
MATCHARR_TRANSACTION_RETRIES=3
MATCHARR_INVITE_ATTEMPTS=8
MATCHARR_INVITE_WINDOW_SECONDS=300
MATCHARR_POLL_INTERVAL_MS=750
MATCHARR_MAX_REQUEST_BYTES=1048576
